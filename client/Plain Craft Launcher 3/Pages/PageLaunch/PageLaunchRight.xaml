<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">

            <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,12"
                          Text="快照版 PCL 包含尚未正式发布的测试功能，仅限赞助者自己使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />

            <!-- 欢迎横幅：左侧标题 + 右侧一言 -->
            <Border x:Name="PanWelcome" CornerRadius="8" Margin="0,0,0,15" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource ColorObject2}" Offset="0" />
                        <GradientStop Color="{DynamicResource ColorObject3}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="26,22,26,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="LabWelcomeTitle" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrushWhite}" Text="欢迎回来" />
                        <TextBlock x:Name="LabWelcomeSub" FontSize="12" Margin="0,6,0,0" Opacity="0.85"
                                   Foreground="{DynamicResource ColorBrushWhite}" TextWrapping="Wrap"
                                   Text="Plain Craft Launcher 3" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" MaxWidth="360" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock x:Name="LabHitokoto" TextWrapping="Wrap" TextAlignment="Right" FontSize="13"
                                   Foreground="{DynamicResource ColorBrushWhite}" Text="正在获取今日一言……" />
                        <TextBlock x:Name="LabHitokotoFrom" TextWrapping="Wrap" TextAlignment="Right" Margin="0,7,0,0"
                                   Opacity="0.75" FontSize="11" Foreground="{DynamicResource ColorBrushWhite}" Text="" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 状态概览：三块统计 -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource ColorBrushBg1}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="当前版本" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="LabStatVersion" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Text="—" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource ColorBrushBg1}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="游戏目录" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="LabStatFolder" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Text="—" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" CornerRadius="6" Background="{DynamicResource ColorBrushBg1}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="本日人品" FontSize="11" Opacity="0.6" />
                        <TextBlock x:Name="LabStatJrrp" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Text="点我查看"
                                   Cursor="Hand" ToolTip="点击查看今日人品" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="PanCustom">
            </StackPanel>

            <!-- 快捷工具 -->
            <local:MyCard Margin="0,0,0,15" Title="快捷工具" x:Name="PanQuickTools">
                <StackPanel Margin="20,38,20,18">
                    <UniformGrid Columns="4">
                        <local:MyButton x:Name="BtnQuickJrrp" Margin="0,0,10,0" Height="35" Text="今日人品" ColorType="Highlight"
                                        ToolTip="看看今天的运气如何" />
                        <local:MyButton x:Name="BtnQuickMemory" Margin="0,0,10,0" Height="35" Text="内存优化"
                                        ToolTip="整理系统内存占用，需要管理员权限" />
                        <local:MyButton x:Name="BtnQuickFolder" Margin="0,0,10,0" Height="35" Text="打开目录"
                                        ToolTip="在资源管理器中打开当前游戏目录" />
                        <local:MyButton x:Name="BtnQuickSettings" Height="35" Text="启动器设置"
                                        ToolTip="打开设置页面" />
                    </UniformGrid>
                </StackPanel>
            </local:MyCard>

            <!-- 投影预览 -->
            <local:MyCard Margin="0,0,0,15" Title="投影预览" x:Name="PanSchematicViewer">
                <StackPanel Margin="20,38,20,18">
                    <TextBlock x:Name="LabSchematicViewerDesc" TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.8"
                               Text="投影预览可以在游戏外查看 .litematic / .nbt / .schem 投影文件。&#xa;首次使用需要先下载（约 394 MB），下载后会自动解压到启动器目录。" />
                    <ProgressBar x:Name="BarSchematicViewer" Height="4" Margin="0,0,0,10"
                                 Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
                    <TextBlock x:Name="LabSchematicViewerState" TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.7"
                               Visibility="Collapsed" Text="" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnSchematicViewerDownload" MinWidth="140" Height="35" Text="下载投影预览" Margin="0,0,12,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnSchematicViewerOpen" MinWidth="140" Height="35" Text="打开一个投影" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 启动日志 -->
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog" IsSwapped="True" CanSwap="True">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" Opacity="0.85" />
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
